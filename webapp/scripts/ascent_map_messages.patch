+    internal bool MapAuditEnabled { get; set; } =
+        Environment.GetEnvironmentVariable("VALO_MAP_AUDIT_RAW") == "1";
+
+    private void CaptureMapAudit(FBitArchive payload, int bits, ContentBlockHeader header,
+        ActorChannelState channel, float time, int packet, string branch)
+    {
+        var path = channel.ActorPath;
+        if (!MapAuditEnabled || path is null || !(
+            path.StartsWith("WindowShield", StringComparison.Ordinal) ||
+            path.StartsWith("Switch_BlackMarket", StringComparison.Ordinal) ||
+            path.StartsWith("B_Site_Door_Switch", StringComparison.Ordinal) ||
+            path.StartsWith("RespawningDestructible", StringComparison.Ordinal) ||
+            path.StartsWith("RespawningWallPlate", StringComparison.Ordinal))) return;
+        // This allowlist scopes evidence retention; it does not bind actors to authored features.
+        var position = payload.Position;
+        byte[] wire = [], transformed = [];
+        var truncated = bits > 65536;
+        try
+        {
+            if (!truncated)
+            {
+                wire = payload.ReadBits(bits).ToArray();
+                payload.SeekBits(position);
+                using var decoded = DecodeContentPayload(payload, bits, channel, branch);
+                transformed = decoded.ReadBits(bits).ToArray();
+            }
+        }
+        finally { payload.SeekBits(position); }
+        _eventSink.Emit(new MapAuditRawContent(time, packet, channel.ActorNetGuid.Value,
+            GetObjectNetGuid(header, channel).Value, channel.ChannelIndex, path,
+            _pathResolver.ResolveExportGroupPath(header, channel),
+            _pathResolver.ResolveClassPath(header, channel), header.IsActor, header.HasRepLayout,
+            bits, truncated, wire, transformed));
+    }
+
