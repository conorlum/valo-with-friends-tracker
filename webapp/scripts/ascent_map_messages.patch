+    [Test]
+    public void MapAudit_CapturesUnknownOddBitBlocksWithoutConsumingNormalStream()
+    {
+        var decoder = new PassthroughPropertyPayloadDecoder();
+        var sink = new CapturingReplayEventSink();
+        var framer = CreateFramer(new NetGuidCache(), new ExportBindingRegistry(), decoder, sink);
+        framer.MapAuditEnabled = true;
+        var payload = BuildContentBlockPayload((true, 8), (false, 13));
+        var channel = new ActorChannelState { ActorNetGuid = new NetworkGuid(100), ActorPath = "WindowShieldA1", ChannelIndex = 66 };
+        var stats = new BunchPayloadStats();
+        framer.FrameContentBlocks(payload, channel, stats, 55, 7, ReplayVersion);
+        var raw = sink.Events.OfType<MapAuditRawContent>().ToArray();
+        Assert.Multiple(() =>
+        {
+            Assert.That(raw.Length, Is.EqualTo(2));
+            Assert.That(raw.Select(x => x.PayloadBits), Is.EqualTo(new[] { 8, 13 }));
+            Assert.That(raw.Select(x => x.WireBytes.Length), Is.EqualTo(new[] { 1, 2 }));
+            Assert.That(raw.All(x => !x.Truncated), Is.True);
+            Assert.That(raw.All(x => x.ActorNetGuid == 100 && x.ChannelIndex == 66), Is.True);
+            Assert.That(sink.Events.OfType<ExportGroupReceived>().All(x => !x.WasDecoded), Is.True);
+            Assert.That(stats.ContentPayloadBitsSkipped, Is.EqualTo(21));
+            Assert.That(stats.ContentBlockCount, Is.EqualTo(2));
+            Assert.That(payload.AtEnd, Is.True);
+        });
+    }
+
