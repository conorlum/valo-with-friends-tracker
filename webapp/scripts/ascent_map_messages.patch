+        framer.MapAuditEnabled = true;
+        var payload = BuildContentBlockPayload(true, 65537);
+        var channel = new ActorChannelState { ActorNetGuid = new NetworkGuid(100), ActorPath = "WindowShieldA1" };
+        var stats = new BunchPayloadStats();
+        framer.FrameContentBlocks(payload, channel, stats, 0, 0, ReplayVersion);
+        var raw = sink.Events.OfType<MapAuditRawContent>().Single();
+        Assert.Multiple(() =>
+        {
+            Assert.That(raw.Truncated, Is.True);
+            Assert.That(raw.WireBytes, Is.Empty);
+            Assert.That(raw.TransformedBytes, Is.Empty);
+            Assert.That(decoder.DecodeCount, Is.Zero);
+            Assert.That(stats.ContentPayloadBitsSkipped, Is.EqualTo(65537));
+            Assert.That(payload.AtEnd, Is.True);
+        });
+    }
